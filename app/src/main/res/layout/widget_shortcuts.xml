<?xml version="1.0" encoding="utf-8"?>
<!-- Widżet „Skróty”: do sześciu skrótów (miksy, losowanie, ulubione, wyłącznik…) i opcjonalny pasek bieżącego utworu. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/w_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_preview_bg"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:id="@+id/w_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:padding="10dp">

        <LinearLayout
            android:id="@+id/w_header"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp">

            <ImageView
                android:id="@+id/w_cover"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_w_note" />

            <LinearLayout
                android:id="@+id/w_info"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:orientation="vertical">

                <TextView

                    android:shadowColor="#52000000"

                    android:shadowDy="1"

                    android:shadowRadius="3"
                    android:id="@+id/w_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/app_name"
                    android:textColor="#FFFFFFFF"
                    android:textSize="14sp" />

                <TextView

                    android:shadowColor="#52000000"

                    android:shadowDy="1"

                    android:shadowRadius="3"
                    android:id="@+id/w_artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#B3FFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="42dp"
                android:layout_height="42dp">

                <ImageView
                    android:id="@+id/w_play_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/widget_circle"
                    android:importantForAccessibility="no" />

                <ImageView
                    android:id="@+id/w_play"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="11dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_w_play" />
            </FrameLayout>

            <ImageView
                android:id="@+id/w_next"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_w_next" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/w_sc0"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp">

                    <ImageView
                        android:id="@+id/w_sc0_bg"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/widget_circle"
                        android:importantForAccessibility="no" />

                    <ImageView
                        android:id="@+id/w_sc0_icon"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="11dp"
                        android:src="@drawable/ic_w_mix"
                        android:importantForAccessibility="no" />
                </FrameLayout>

                <TextView

                    android:shadowColor="#52000000"

                    android:shadowDy="1"

                    android:shadowRadius="3"
                    android:id="@+id/w_sc0_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:gravity="center_horizontal"
                    android:maxLines="1"
                    android:textColor="#B3FFFFFF"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/w_sc1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp">

                    <ImageView
                        android:id="@+id/w_sc1_bg"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/widget_circle"
                        android:importantForAccessibility="no" />

                    <ImageView
                        android:id="@+id/w_sc1_icon"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="11dp"
                        android:src="@drawable/ic_w_mix"
                        android:importantForAccessibility="no" />
                </FrameLayout>

                <TextView

                    android:shadowColor="#52000000"

                    android:shadowDy="1"

                    android:shadowRadius="3"
                    android:id="@+id/w_sc1_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:gravity="center_horizontal"
                    android:maxLines="1"
                    android:textColor="#B3FFFFFF"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/w_sc2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp">

                    <ImageView
                        android:id="@+id/w_sc2_bg"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/widget_circle"
                        android:importantForAccessibility="no" />

                    <ImageView
                        android:id="@+id/w_sc2_icon"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="11dp"
                        android:src="@drawable/ic_w_mix"
                        android:importantForAccessibility="no" />
                </FrameLayout>

                <TextView

                    android:shadowColor="#52000000"

                    android:shadowDy="1"

                    android:shadowRadius="3"
                    android:id="@+id/w_sc2_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:gravity="center_horizontal"
                    android:maxLines="1"
                    android:textColor="#B3FFFFFF"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/w_sc3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp">

                    <ImageView
                        android:id="@+id/w_sc3_bg"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/widget_circle"
                        android:importantForAccessibility="no" />

                    <ImageView
                        android:id="@+id/w_sc3_icon"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="11dp"
                        android:src="@drawable/ic_w_mix"
                        android:importantForAccessibility="no" />
                </FrameLayout>

                <TextView

                    android:shadowColor="#52000000"

                    android:shadowDy="1"

                    android:shadowRadius="3"
                    android:id="@+id/w_sc3_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:gravity="center_horizontal"
                    android:maxLines="1"
                    android:textColor="#B3FFFFFF"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/w_sc4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp">

                    <ImageView
                        android:id="@+id/w_sc4_bg"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/widget_circle"
                        android:importantForAccessibility="no" />

                    <ImageView
                        android:id="@+id/w_sc4_icon"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="11dp"
                        android:src="@drawable/ic_w_mix"
                        android:importantForAccessibility="no" />
                </FrameLayout>

                <TextView

                    android:shadowColor="#52000000"

                    android:shadowDy="1"

                    android:shadowRadius="3"
                    android:id="@+id/w_sc4_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:gravity="center_horizontal"
                    android:maxLines="1"
                    android:textColor="#B3FFFFFF"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/w_sc5"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp">

                    <ImageView
                        android:id="@+id/w_sc5_bg"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/widget_circle"
                        android:importantForAccessibility="no" />

                    <ImageView
                        android:id="@+id/w_sc5_icon"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="11dp"
                        android:src="@drawable/ic_w_mix"
                        android:importantForAccessibility="no" />
                </FrameLayout>

                <TextView

                    android:shadowColor="#52000000"

                    android:shadowDy="1"

                    android:shadowRadius="3"
                    android:id="@+id/w_sc5_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:gravity="center_horizontal"
                    android:maxLines="1"
                    android:textColor="#B3FFFFFF"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
