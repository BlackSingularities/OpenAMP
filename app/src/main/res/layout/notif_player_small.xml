<?xml version="1.0" encoding="utf-8"?>
<!-- Własne powiadomienie (zwinięte): okładka na całą wysokość po lewej, tekst i przyciski. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/n_cover"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_w_note"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/n_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="4dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textSize="13sp"
        android:textStyle="bold" />
            <ImageView android:id="@+id/n_prev" android:layout_width="34dp" android:layout_height="34dp" android:layout_marginStart="1dp" android:layout_marginEnd="1dp" android:padding="6dp" android:scaleType="fitCenter"  android:src="@drawable/ic_w_prev" android:contentDescription="@null" />
            <ImageView android:id="@+id/n_play" android:layout_width="40dp" android:layout_height="40dp" android:layout_marginStart="2dp" android:layout_marginEnd="2dp" android:padding="8dp" android:scaleType="fitCenter" android:background="@drawable/notif_play_bg" android:src="@drawable/ic_w_play" android:contentDescription="@null" />
            <ImageView android:id="@+id/n_next" android:layout_width="34dp" android:layout_height="34dp" android:layout_marginStart="1dp" android:layout_marginEnd="1dp" android:padding="6dp" android:scaleType="fitCenter"  android:src="@drawable/ic_w_next" android:contentDescription="@null" />
</LinearLayout>
